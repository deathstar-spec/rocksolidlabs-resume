---
import type { incidents } from '../data/incidents.js';
interface Props { incident: (typeof incidents)[number] }
const { incident } = Astro.props;
const titleId = `incident-${incident.number}-title`;
const stages = [
  { title: 'Symptoms', items: incident.symptoms },
  { title: 'Investigation', items: incident.investigation },
];
---

<article class="card incident-card" id={`incident-${incident.number}`} aria-labelledby={titleId}>
  <div class="incident-overview">
    <div class="incident-meta">
      <span class="incident-number">INCIDENT {incident.number}</span>
      <span class="project-status">RESOLVED</span>
    </div>
    <h3 id={titleId}>{incident.title}</h3>
    <p class="incident-impact"><strong>Impact</strong>{incident.impact}</p>
    <ul class="incident-technologies" aria-label="Technologies used">
      {incident.technologies.map((technology) => <li>{technology}</li>)}
    </ul>
  </div>
  <details>
    <summary>
      <span>Incident report<span class="sr-only">: {incident.title}</span></span>
      <span class="expand-icon" aria-hidden="true"></span>
    </summary>
    <div class="incident-report">
      {stages.map(({ title, items }) => (
        <div>
          <h4>{title}</h4>
          <ul class="detail-list">{items.map((item) => <li>{item}</li>)}</ul>
        </div>
      ))}
      <div class="lesson-box root-cause">
        <h4>Root cause</h4>
        <p>{incident.rootCause}</p>
      </div>
      <div>
        <h4>Resolution</h4>
        <ul class="detail-list">{incident.resolution.map((item) => <li>{item}</li>)}</ul>
      </div>
      <div>
        <h4>Prevention / lessons learned</h4>
        <ul class="detail-list">{incident.lessons.map((item) => <li>{item}</li>)}</ul>
      </div>
    </div>
  </details>
</article>

<style>
  .incident-card { padding: 0; margin-top: 24px; scroll-margin-top: 110px; overflow-wrap: anywhere; }
  .incident-overview { padding: 28px; }
  .incident-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 18px; }
  .incident-number { color: var(--orange); font: 0.85rem ui-monospace, monospace; letter-spacing: 0.08em; }
  h3 { font-size: clamp(1.3rem, 3vw, 1.8rem); line-height: 1.3; margin-bottom: 18px; }
  .incident-impact strong { display: block; color: var(--text); margin-bottom: 6px; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .incident-technologies { display: flex; flex-wrap: wrap; gap: 8px; padding: 0; margin: 22px 0 0; list-style: none; }
  .incident-technologies li { border: 1px solid var(--border); border-radius: 999px; padding: 6px 10px; color: var(--muted); font: 0.82rem/1.5 ui-monospace, monospace; }
  summary { display: flex; justify-content: space-between; align-items: center; gap: 16px; cursor: pointer; padding: 18px 28px; border-top: 1px solid var(--border); color: var(--orange); font: 0.9rem/1.5 ui-monospace, monospace; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { background: var(--orange-soft); }
  summary:focus-visible { outline: 3px solid var(--orange); outline-offset: -5px; border-radius: 8px; }
  .expand-icon::before { content: '+'; font-size: 1.3rem; }
  details[open] .expand-icon::before { content: '−'; }
  .incident-report { padding: 8px 28px 28px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 32px; }
  h4 { margin: 0 0 12px; font-size: 1rem; color: var(--text); }
  .detail-list { margin: 0; }
  .root-cause { grid-column: 1 / -1; margin-top: 0; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 650px) {
    .incident-overview { padding: 20px; }
    summary { padding: 18px 20px; }
    .incident-report { grid-template-columns: minmax(0, 1fr); padding: 8px 20px 20px; gap: 24px; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
  }
</style>
