<!-- LIVE ARCHITECTURE HEALTH -->
<script>
  import { publicGroups, summarizeMonitors, stateLabel } from '../lib/monitoring.js';
  (() => {
    const CONFIG_URL = "/api/lab-status/config";
    const HEARTBEAT_URL = "/api/lab-status/heartbeat";
    const POLL_INTERVAL = 60000;

    let healthState = {};

    const neutralNodes = [
      "portarthur",
      "app-vms",
      "resume"
    ];

    function normalize(value) {
      return String(value || "").trim().toLowerCase();
    }

    function ensureNodeBadge(node) {
      let badge = node.querySelector(".live-node-status");

      if (!badge) {
        badge = document.createElement("span");
        badge.className = "live-node-status";

        badge.innerHTML = `
          <span class="live-node-dot"></span>
          <span class="live-node-label"></span>
        `;

        node.appendChild(badge);
      }

      return badge;
    }

    function renderNodeHealth(key, status) {
      const node = document.querySelector(
        `[data-node="${key}"]`
      );

      if (!node) return;

      node.classList.remove(
        "live-healthy",
        "live-degraded",
        "live-offline",
        "live-maintenance",
        "live-unknown",
        "live-neutral"
      );

      node.classList.add(`live-${status.state}`);

      const badge = ensureNodeBadge(node);

      badge.className =
        `live-node-status live-node-status-${status.state}`;

      const label =
        badge.querySelector(".live-node-label");

      if (label) {
        label.textContent = stateLabel(status.state);
      }
    }

    function ensureDetailHealthPanel() {
      let panel =
        document.querySelector("#architecture-live-detail");

      if (panel) {
        return panel;
      }

      const securityNote =
        document.querySelector(
          ".architecture-details .security-note"
        );

      const details =
        document.querySelector(".architecture-details");

      if (!details) {
        return null;
      }

      panel = document.createElement("div");
      panel.id = "architecture-live-detail";
      panel.className = "detail-section architecture-live-detail";

      panel.innerHTML = `
        <label>LIVE MONITORING</label>

        <div class="architecture-live-summary">
          <div class="architecture-live-state">
            <span class="architecture-live-dot"></span>
            <strong id="architecture-live-label">
              Checking...
            </strong>
          </div>

          <span id="architecture-live-count"></span>
        </div>

        <div
          id="architecture-live-meta"
          class="architecture-live-meta"
        >
          Connecting to monitoring data...
        </div>
      `;

      if (securityNote) {
        securityNote.before(panel);
      } else {
        details.appendChild(panel);
      }

      return panel;
    }

    function updateDetailHealth(key) {
      ensureDetailHealthPanel();

      const status = healthState[key];

      const panel =
        document.querySelector("#architecture-live-detail");

      const label =
        document.querySelector("#architecture-live-label");

      const count =
        document.querySelector("#architecture-live-count");

      const meta =
        document.querySelector("#architecture-live-meta");

      if (!panel || !label || !count || !meta) {
        return;
      }

      panel.classList.remove(
        "detail-health-healthy",
        "detail-health-degraded",
        "detail-health-offline",
        "detail-health-maintenance",
        "detail-health-unknown",
        "detail-health-neutral"
      );

      if (!status) {
        panel.classList.add("detail-health-unknown");

        label.textContent = "Status unavailable";
        count.textContent = "";
        meta.textContent =
          "Monitoring data has not loaded yet.";

        return;
      }

      panel.classList.add(
        `detail-health-${status.state}`
      );

      label.textContent = stateLabel(status.state);

      if (status.state === "neutral") {
        count.textContent =
          "Not included in public monitoring";

        meta.textContent =
          "This system is intentionally shown without a live health state.";

        return;
      }

      if (status.state === "unknown") {
        count.textContent = "Monitoring data unavailable or incomplete";
        meta.textContent = "A current health state could not be determined.";
        return;
      }

      const noun =
        status.total === 1 ? "monitor" : "monitors";

      count.textContent =
        `${status.healthy}/${status.total} ${noun} healthy`;

      const uptimeText =
        typeof status.uptime === "number"
          ? `${status.uptime.toFixed(2)}% average 24h uptime`
          : "24h uptime unavailable";

      const checked =
        new Date().toLocaleTimeString([], {
          hour: "numeric",
          minute: "2-digit",
          second: "2-digit"
        });

      meta.textContent =
        `${uptimeText} · Refreshed ${checked}`;
    }

    function updateActiveDetail() {
      const active =
        document.querySelector(
          ".architecture-node.active[data-node]"
        );

      if (!active) return;

      updateDetailHealth(
        active.getAttribute("data-node")
      );
    }

    async function refreshHealth() {
      try {
        const [configResponse, heartbeatResponse] =
          await Promise.all([
            fetch(CONFIG_URL, { cache: "no-store" }),
            fetch(HEARTBEAT_URL, { cache: "no-store" })
          ]);

        if (
          !configResponse.ok ||
          !heartbeatResponse.ok
        ) {
          throw new Error(
            "Monitoring endpoint returned an error."
          );
        }

        const configData =
          await configResponse.json();

        const heartbeatData =
          await heartbeatResponse.json();

        const groups =
          publicGroups(configData);

        const allMonitors =
          groups.flatMap(
            (group) => group.monitorList || []
          );

        const findMonitorId = (name) => {
          const monitor =
            allMonitors.find(
              (item) =>
                normalize(item.name) ===
                normalize(name)
            );

          return monitor?.id;
        };

        const projectOrange =
          groups.find(
            (group) =>
              normalize(group.name) ===
              "project orange"
          );

        const allIds =
          allMonitors.map((monitor) => monitor.id);

        const projectOrangeIds =
          (projectOrange?.monitorList || [])
            .map((monitor) => monitor.id);

        const mappings = {
          rsl: allIds,

          orangebox: [
            findMonitorId("Proxmox")
          ],

          truenas: [
            findMonitorId("TrueNAS")
          ],

          core: [
            findMonitorId("Pi-Hole"),
            findMonitorId("Plex")
          ],

          "project-orange":
            projectOrangeIds
        };

        healthState = {};

        Object.entries(mappings).forEach(
          ([key, ids]) => {
            healthState[key] =
              summarizeMonitors(ids, heartbeatData);
          }
        );

        neutralNodes.forEach((key) => {
          healthState[key] = {
            state: "neutral",
            healthy: 0,
            total: 0,
            uptime: null
          };
        });

        Object.entries(healthState).forEach(
          ([key, status]) => {
            renderNodeHealth(key, status);
          }
        );

        updateActiveDetail();
      } catch (error) {
        console.error(
          "Rock Solid Labs live architecture status failed:",
          error
        );

        [
          "rsl",
          "orangebox",
          "truenas",
          "core",
          "project-orange"
        ].forEach((key) => {
          healthState[key] = {
            state: "unknown",
            healthy: 0,
            total: 0,
            uptime: null
          };

          renderNodeHealth(
            key,
            healthState[key]
          );
        });

        neutralNodes.forEach((key) => {
          healthState[key] = {
            state: "neutral",
            healthy: 0,
            total: 0,
            uptime: null
          };

          renderNodeHealth(
            key,
            healthState[key]
          );
        });

        updateActiveDetail();
      }
    }

    document
      .querySelectorAll(
        ".architecture-node[data-node]"
      )
      .forEach((node) => {
        node.addEventListener("click", () => {
          const key =
            node.getAttribute("data-node");

          setTimeout(
            () => updateDetailHealth(key),
            0
          );
        });
      });

    ensureDetailHealthPanel();

    refreshHealth();

    window.setInterval(
      refreshHealth,
      POLL_INTERVAL
    );
  })();
</script>


