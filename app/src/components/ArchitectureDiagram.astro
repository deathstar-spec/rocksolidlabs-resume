<section id="architecture" class="architecture lab-only">
  <div class="architecture-heading">
    <div>
      <div class="architecture-eyebrow">SYSTEM MAP</div>
      <h2>Rock Solid Labs Architecture</h2>
      <p>
        A sanitized view of the infrastructure behind Rock Solid Labs.
        Select a system to explore what it does and the technologies behind it.
      </p>
    </div>

    <div class="architecture-badge">
      <span></span>
      PUBLIC VIEW
    </div>
  </div>

  <div class="architecture-shell">

    <div class="architecture-map">

      <div class="root-row">
        <button
          class="architecture-node root-node active"
          data-node="rsl"
          type="button"
        >
          <small>HOMELAB PLATFORM</small>
          <strong>Rock Solid Labs</strong>
          <span>Infrastructure Environment</span>
        </button>
      </div>

      <div class="root-line"></div>

      <div class="host-grid">

        <div class="host-column">
          <div class="host-line"></div>

          <button
            class="architecture-node host-node"
            data-node="orangebox"
            type="button"
          >
            <i></i>
            <small>PRIMARY HOST</small>
            <strong>OrangeBox</strong>
            <span>Proxmox VE</span>
          </button>

          <div class="child-line"></div>

          <div class="child-grid">

            <button
              class="architecture-node child-node"
              data-node="truenas"
              type="button"
            >
              <small>STORAGE</small>
              <strong>TrueNAS</strong>
              <span>Shared Storage</span>
            </button>

            <button
              class="architecture-node child-node"
              data-node="core"
              type="button"
            >
              <small>CORE SERVICES</small>
              <strong>Infrastructure</strong>
              <span>DNS · VPN · Media</span>
            </button>

            <button
              class="architecture-node child-node orange-node"
              data-node="project-orange"
              type="button"
            >
              <small>DOCKER PLATFORM</small>
              <strong>Project Orange</strong>
              <span>Containers · Monitoring</span>
            </button>

          </div>
        </div>


        <div class="host-column">
          <div class="host-line"></div>

          <button
            class="architecture-node host-node"
            data-node="portarthur"
            type="button"
          >
            <i></i>
            <small>APPLICATION HOST</small>
            <strong>Port Arthur</strong>
            <span>Proxmox VE</span>
          </button>

          <div class="child-line"></div>

          <div class="child-grid">

            <button
              class="architecture-node child-node"
              data-node="app-vms"
              type="button"
            >
              <small>WORKLOADS</small>
              <strong>Application VMs</strong>
              <span>Ubuntu · Docker</span>
            </button>

            <button
              class="architecture-node child-node orange-node"
              data-node="resume"
              type="button"
            >
              <small>WEB PLATFORM</small>
              <strong>resume-web</strong>
              <span>Astro · Nginx · Docker</span>
            </button>

          </div>
        </div>

      </div>
    </div>


    <aside class="architecture-details">

      <div class="details-top">
        <div>
          <small id="detail-kind">HOMELAB PLATFORM</small>
          <h3 id="detail-title">Rock Solid Labs</h3>
        </div>

        <div class="selected-indicator">
          <span></span>
          SELECTED
        </div>
      </div>

      <p id="detail-description">
        A multi-host self-hosted environment used to build, operate,
        troubleshoot and recover real infrastructure services.
      </p>

      <div class="detail-section">
        <label>TECHNOLOGIES</label>

        <div id="detail-tags" class="detail-tags">
          <span>Proxmox VE</span>
          <span>Linux</span>
          <span>Docker</span>
          <span>Networking</span>
          <span>Storage</span>
          <span>Monitoring</span>
        </div>
      </div>

      <div class="detail-section">
        <label>WHAT IT DEMONSTRATES</label>

        <p id="detail-demo">
          Practical infrastructure design, virtualization, service isolation,
          storage integration, monitoring and recovery.
        </p>
      </div>

      <div class="security-note">
        <b>◈</b>
        Private addressing, management endpoints and sensitive configuration
        are intentionally omitted.
      </div>

    </aside>

  </div>
</section>


<script>
  const data = {
    rsl: {
      kind: "HOMELAB PLATFORM",
      title: "Rock Solid Labs",
      description:
        "A multi-host self-hosted environment used to build, operate, troubleshoot and recover real infrastructure services.",
      tags: [
        "Proxmox VE",
        "Linux",
        "Docker",
        "Networking",
        "Storage",
        "Monitoring"
      ],
      demo:
        "Practical infrastructure design, virtualization, service isolation, storage integration, monitoring and recovery."
    },

    orangebox: {
      kind: "PRIMARY VIRTUALIZATION HOST",
      title: "OrangeBox",
      description:
        "The primary infrastructure platform supporting storage, network services, media services and containerized workloads.",
      tags: [
        "Proxmox VE",
        "Linux",
        "LXC",
        "Virtual Machines",
        "SMB/CIFS"
      ],
      demo:
        "Hypervisor administration, Linux operations, service dependencies, storage integration and infrastructure recovery."
    },

    truenas: {
      kind: "CENTRALIZED STORAGE",
      title: "TrueNAS",
      description:
        "Centralized network storage providing persistent datasets and shared storage to multiple systems throughout the lab.",
      tags: [
        "TrueNAS SCALE",
        "SMB",
        "CIFS",
        "Datasets",
        "Network Storage"
      ],
      demo:
        "Storage administration, network shares, persistent mounts and recovery from storage-related failures."
    },

    core: {
      kind: "CORE INFRASTRUCTURE",
      title: "Core Services",
      description:
        "Always-on infrastructure services providing DNS filtering, secure remote access, media delivery and automation.",
      tags: [
        "Pi-hole",
        "WireGuard",
        "Plex",
        "Home Assistant",
        "DNS",
        "Linux"
      ],
      demo:
        "DNS troubleshooting, secure remote connectivity, service management and dependency troubleshooting."
    },

    "project-orange": {
      kind: "DOCKER APPLICATION PLATFORM",
      title: "Project Orange",
      description:
        "An Ubuntu Docker environment hosting containerized applications, selected VPN-routed services, automation and monitoring.",
      tags: [
        "Docker",
        "Docker Compose",
        "Gluetun",
        "Uptime Kuma",
        "Nginx",
        "Cloudflare"
      ],
      demo:
        "Container networking, Compose orchestration, VPN routing, persistent storage and application recovery."
    },

    portarthur: {
      kind: "APPLICATION VIRTUALIZATION HOST",
      title: "Port Arthur",
      description:
        "A separate virtualization host designed to isolate application and public-facing workloads from the primary lab environment.",
      tags: [
        "Proxmox VE",
        "Ubuntu Server",
        "QEMU",
        "Docker",
        "Workload Isolation"
      ],
      demo:
        "Workload segmentation, virtualization, Linux administration and separation between hypervisor and application services."
    },

    "app-vms": {
      kind: "ISOLATED APPLICATION WORKLOADS",
      title: "Application VMs",
      description:
        "Dedicated Ubuntu virtual machines isolate application workloads from the hypervisor and from unrelated services.",
      tags: [
        "Ubuntu Server",
        "Virtual Machines",
        "Docker Engine",
        "Compose",
        "QEMU Guest Agent"
      ],
      demo:
        "VM lifecycle management, Linux administration, application isolation and cleaner failure boundaries."
    },

    resume: {
      kind: "PUBLIC WEB PLATFORM",
      title: "resume-web",
      description:
        "A dedicated application VM hosting this Rock Solid Labs portfolio and its supporting web stack.",
      tags: [
        "Astro",
        "Nginx",
        "Docker",
        "Git",
        "JavaScript",
        "CSS"
      ],
      demo:
        "Building and operating a complete self-hosted web application from source control through containerized deployment."
    }
  };

  const nodes = document.querySelectorAll(".architecture-node");

  const kind = document.querySelector("#detail-kind");
  const title = document.querySelector("#detail-title");
  const description = document.querySelector("#detail-description");
  const tags = document.querySelector("#detail-tags");
  const demo = document.querySelector("#detail-demo");

  nodes.forEach((node) => {
    node.addEventListener("click", () => {
      const key = node.getAttribute("data-node");
      const item = data[key];

      if (!item) return;

      nodes.forEach((n) => n.classList.remove("active"));
      node.classList.add("active");

      kind.textContent = item.kind;
      title.textContent = item.title;
      description.textContent = item.description;
      demo.textContent = item.demo;

      tags.innerHTML = "";

      item.tags.forEach((tag) => {
        const el = document.createElement("span");
        el.textContent = tag;
        tags.appendChild(el);
      });
    });
  });
</script>


