<div class="live-status" id="live-lab-status">

  <div class="live-header">
    <div>
      <div class="live-kicker">LIVE INFRASTRUCTURE</div>
      <h3>Rock Solid Labs Status</h3>
      <p>
        Real-time health from selected homelab infrastructure and
        Project Orange services.
      </p>
    </div>

    <div class="overall loading" id="lab-overall">
      <span class="dot"></span>
      <span>Connecting...</span>
    </div>
  </div>

  <div
    class="status-groups"
    id="lab-status-groups"
    aria-live="polite"
  >
    <div class="loading-message">
      Retrieving live infrastructure status...
    </div>
  </div>

  <div class="live-footer">
    <span id="lab-status-updated">Live data via Uptime Kuma</span>
    <span>24-hour uptime · recent heartbeat history</span>
  </div>

</div>

<script>
  const root = document.querySelector('#live-lab-status');

  if (root && !root.dataset.initialized) {
    root.dataset.initialized = 'true';

    const groupsRoot =
      root.querySelector('#lab-status-groups');

    const overall =
      root.querySelector('#lab-overall');

    const updated =
      root.querySelector('#lab-status-updated');

    function state(status) {
      if (status === 1) {
        return { label: 'Operational', css: 'up' };
      }

      if (status === 0) {
        return { label: 'Offline', css: 'down' };
      }

      if (status === 3) {
        return { label: 'Maintenance', css: 'maintenance' };
      }

      return { label: 'Checking', css: 'pending' };
    }

    function badgeClass(groupName) {
      const name = groupName.toLowerCase();

      if (name.includes('orange')) return 'orange';
      if (name.includes('core')) return 'core';
      if (name.includes('web')) return 'web';

      return 'default';
    }

    function monitorRow(groupName, monitor, heartbeats) {
      const history =
        heartbeats.heartbeatList[String(monitor.id)] || [];

      const latest = history[history.length - 1];
      const current = state(latest?.status);

      const uptimeValue =
        heartbeats.uptimeList[`${monitor.id}_24`];

      const uptime =
        typeof uptimeValue === 'number'
          ? `${(uptimeValue * 100).toFixed(
              uptimeValue === 1 ? 0 : 2
            )}%`
          : '—';

      const row = document.createElement('div');
      row.className = 'status-row';

      const details = document.createElement('div');
      details.className = 'status-details';

      const percent = document.createElement('span');
      percent.className = `uptime ${current.css}`;
      percent.textContent = uptime;

      const service = document.createElement('div');
      service.className = 'service';

      const serviceName = document.createElement('strong');
      serviceName.textContent = monitor.name;

      const badge = document.createElement('span');
      badge.className =
        `badge ${badgeClass(groupName)}`;
      badge.textContent = groupName;

      service.append(serviceName, badge);
      details.append(percent, service);

      const bars = document.createElement('div');
      bars.className = 'heartbeat-bars';

      history.slice(-28).forEach((beat) => {
        const info = state(beat.status);

        const bar = document.createElement('span');
        bar.className = `heartbeat ${info.css}`;

        bar.title =
          `${info.label}` +
          (typeof beat.ping === 'number'
            ? ` · ${beat.ping} ms`
            : '');

        bars.appendChild(bar);
      });

      row.append(details, bars);

      return {
        row,
        status: latest?.status
      };
    }

    async function refreshStatus() {
      try {
        const [configResponse, heartbeatResponse] =
          await Promise.all([
            fetch('/api/lab-status/config', {
              cache: 'no-store'
            }),
            fetch('/api/lab-status/heartbeat', {
              cache: 'no-store'
            })
          ]);

        if (!configResponse.ok || !heartbeatResponse.ok) {
          throw new Error('Status endpoint unavailable');
        }

        const config = await configResponse.json();
        const heartbeats = await heartbeatResponse.json();

        groupsRoot.innerHTML = '';

        const currentStatuses = [];

        for (const group of config.publicGroupList || []) {

          const groupSection =
            document.createElement('div');

          groupSection.className = 'status-group';

          const groupHeader =
            document.createElement('div');

          groupHeader.className = 'group-header';

          const title = document.createElement('h4');
          title.textContent = group.name;

          const count = document.createElement('span');
          count.textContent =
            `${group.monitorList.length} services`;

          groupHeader.append(title, count);
          groupSection.appendChild(groupHeader);

          for (const monitor of group.monitorList) {

            const result =
              monitorRow(
                group.name,
                monitor,
                heartbeats
              );

            groupSection.appendChild(result.row);
            currentStatuses.push(result.status);
          }

          groupsRoot.appendChild(groupSection);
        }

        const allUp =
          currentStatuses.length > 0 &&
          currentStatuses.every(
            (status) => status === 1
          );

        const anyDown =
          currentStatuses.some(
            (status) => status === 0
          );

        overall.className =
          `overall ${
            allUp
              ? 'up'
              : anyDown
                ? 'down'
                : 'pending'
          }`;

        overall.querySelector('span:last-child').textContent =
          allUp
            ? 'All Systems Operational'
            : anyDown
              ? 'Service Disruption'
              : 'Status Updating';

        updated.textContent =
          `Updated ${new Date().toLocaleTimeString([], {
            hour: 'numeric',
            minute: '2-digit'
          })}`;

      } catch (error) {

        groupsRoot.innerHTML =
          '<div class="status-error">Live status is temporarily unavailable.</div>';

        overall.className = 'overall pending';

        overall.querySelector('span:last-child').textContent =
          'Status Unavailable';

        updated.textContent =
          'Unable to reach monitoring service';
      }
    }

    refreshStatus();

    setInterval(refreshStatus, 60000);
  }
</script>

