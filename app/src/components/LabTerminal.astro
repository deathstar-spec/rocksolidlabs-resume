    scrollbar-color:
      rgba(255,122,0,.28)
      transparent;
  }

  .terminal-line {
    min-height: 1.45em;

    color: #c5c5cb;

    font-family:
      "SFMono-Regular",
      Consolas,
      "Liberation Mono",
      monospace;

    font-size: .78rem;
    line-height: 1.55;

    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .terminal-spacer {
