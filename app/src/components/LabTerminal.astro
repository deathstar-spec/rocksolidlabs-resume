    max-width: 700px;
    margin: 12px 0 0;
    color: #92929b;
    line-height: 1.65;
  }

  .lab-terminal-sandbox {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    padding: 8px 12px;

    border: 1px solid rgba(74,222,128,.18);
    border-radius: 999px;

    background: rgba(74,222,128,.03);

    color: #9b9ba4;
