<section id="lab-terminal" class="lab-terminal lab-only">
  <div class="lab-terminal-heading">
    <div>
      <div class="lab-terminal-eyebrow">INTERACTIVE CONSOLE</div>
      <h2>Rock Solid Labs Terminal</h2>
      <p>
        Explore the lab from a sandboxed command interface. This terminal
        does not execute shell commands or expose infrastructure access.
      </p>
    </div>

    <div class="lab-terminal-sandbox">
      <span></span>
      SANDBOXED
    </div>
  </div>

  <div class="terminal-window">
    <div class="terminal-titlebar">
      <div class="terminal-window-controls" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>

      <div class="terminal-title">
        visitor@rocksolidlabs
      </div>

      <div class="terminal-security">
        READ ONLY
      </div>
    </div>

    <div
      id="terminal-output"
      class="terminal-output"
      aria-live="polite"
    >
      <div class="terminal-line terminal-muted">
        Rock Solid Labs Interactive Console
      </div>

      <div class="terminal-line terminal-muted">
        Type <span class="terminal-orange">help</span> to see available commands.
      </div>

      <div class="terminal-line terminal-spacer"></div>
    </div>

    <div class="terminal-input-row">
      <label for="terminal-input" class="terminal-prompt">
        <span class="terminal-user">visitor</span><span>@</span><span class="terminal-host">rocksolidlabs</span><span>:~$</span>
      </label>

      <input
        id="terminal-input"
        class="terminal-input"
        type="text"
        maxlength="160"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        aria-label="Rock Solid Labs terminal command"
      />

      <span class="terminal-cursor" aria-hidden="true"></span>
    </div>
  </div>

  <div class="terminal-command-hints">
    <span>TRY:</span>
    <button type="button" data-terminal-command="help">help</button>
    <button type="button" data-terminal-command="status">status</button>
    <button type="button" data-terminal-command="skills">skills</button>
    <button type="button" data-terminal-command="projects">projects</button>
    <button type="button" data-terminal-command="whoami">whoami</button>
  </div>
</section>


<script>
  (() => {
    const root = document.querySelector("#lab-terminal");
    const output = document.querySelector("#terminal-output");
    const input = document.querySelector("#terminal-input");

    if (!root || !output || !input) return;

    const CONFIG_URL = "/api/lab-status/config";
    const HEARTBEAT_URL = "/api/lab-status/heartbeat";

    const history = [];
    let historyIndex = 0;

    const commands = {
      help: runHelp,
      about: runAbout,
      skills: runSkills,
      projects: runProjects,
      status: runStatus,
      uptime: runUptime,
      whoami: runWhoami,
      contact: runContact,
      orangebox: runOrangeBox,
      portarthur: runPortArthur,
      clear: runClear
    };

    function appendLine(text = "", className = "") {
      const line = document.createElement("div");
      line.className = "terminal-line";

      if (className) {
        line.classList.add(className);
      }

      /*
       * SECURITY:
       * textContent is intentional.
       * Never render visitor input with innerHTML.
       */
      line.textContent = String(text);

      output.appendChild(line);
      scrollToBottom();

      return line;
    }

    function appendCommand(command) {
      const line = document.createElement("div");
      line.className = "terminal-line terminal-command-line";

      const prompt = document.createElement("span");
      prompt.className = "terminal-inline-prompt";
      prompt.textContent = "visitor@rocksolidlabs:~$ ";

      const commandText = document.createElement("span");
      commandText.className = "terminal-command-text";

      /*
       * Visitor-controlled value.
       * textContent prevents HTML/script interpretation.
       */
      commandText.textContent = command;

      line.appendChild(prompt);
      line.appendChild(commandText);

      output.appendChild(line);
      scrollToBottom();
    }

    function appendStatus(label, value, status = "neutral") {
      const line = document.createElement("div");
      line.className = "terminal-line terminal-status-line";

      const left = document.createElement("span");
      left.className = "terminal-status-label";
      left.textContent = label;

      const right = document.createElement("span");
      right.className = `terminal-status-value terminal-status-${status}`;
      right.textContent = value;

      line.appendChild(left);
      line.appendChild(right);

      output.appendChild(line);
      scrollToBottom();
    }

    function appendSecurity(lines) {
      appendLine("");

      lines.forEach((line, index) => {
        appendLine(
          line,
          index === 0
            ? "terminal-danger"
            : "terminal-warning"
        );
      });

      appendLine("");
    }

    function scrollToBottom() {
      output.scrollTop = output.scrollHeight;
    }

    function normalize(command) {
      return command.trim().toLowerCase();
    }

    function suspiciousCommand(command) {
      const value = normalize(command);

      if (
        value.includes("drop table") ||
        value.includes(" or 1=1") ||
        value.includes("' or '1'='1") ||
        value.includes("\" or \"1\"=\"1") ||
        value.includes("union select") ||
        value.includes("sqlmap")
      ) {
        return "sql";
      }

      if (
        value.includes("<script") ||
        value.includes("javascript:") ||
        value.includes("onerror=") ||
        value.includes("onload=")
      ) {
        return "xss";
      }

      if (
        value === "sudo" ||
        value.startsWith("sudo ") ||
        value === "su" ||
        value === "su -" ||
        value.includes("sudo su")
      ) {
        return "privilege";
      }

      if (
        value.includes("rm -rf") ||
        value.includes("mkfs.") ||
        value.includes("dd if=")
      ) {
        return "destructive";
      }

      if (
        value.includes("../") ||
        value.includes("..\\") ||
        value.includes("/etc/passwd") ||
        value.includes("/etc/shadow")
      ) {
        return "traversal";
      }

      if (
        value.startsWith("nmap") ||
        value.startsWith("hydra") ||
        value.startsWith("nikto") ||
        value.startsWith("gobuster") ||
        value.startsWith("dirbuster")
      ) {
        return "recon";
      }

      return null;
    }

    function handleSuspicious(type) {
      switch (type) {
        case "sql":
          appendSecurity([
            "[SECURITY] UNAUTHORIZED QUERY ATTEMPT DETECTED",
            "[INFO] There is no database behind this terminal.",
            "[INFO] Incident severity: adorable."
          ]);
          break;

        case "xss":
          appendSecurity([
            "[SECURITY] SCRIPT INJECTION ATTEMPT BLOCKED",
            "[INFO] Visitor input is rendered as text, not executable markup.",
            "[INFO] Nice try."
          ]);
          break;

        case "privilege":
          appendSecurity([
            "[SECURITY] UNAUTHORIZED PRIVILEGE ESCALATION ATTEMPT",
            "[DENIED] Visitor permissions remain aggressively limited.",
            "[INFO] Good instincts, though."
          ]);
          break;

        case "destructive":
          appendSecurity([
            "[DENIED] Absolutely not.",
            "[INFO] This homelab has survived enough already."
          ]);
          break;

        case "traversal":
          appendSecurity([
            "[SECURITY] PATH TRAVERSAL ATTEMPT DETECTED",
            "[DENIED] Local files are not accessible from this interface.",
            "[INFO] Please remain inside the gift shop."
          ]);
          break;

        case "recon":
          appendSecurity([
            "[SECURITY] RECONNAISSANCE ATTEMPT DETECTED",
            "[DENIED] No scanning capabilities are exposed here.",
            "[INFO] You may inspect the architecture diagram instead."
          ]);
          break;
      }
    }

    function runHelp() {
      appendLine("");
      appendLine("AVAILABLE COMMANDS", "terminal-orange");

      appendStatus("help", "Show available commands");
      appendStatus("about", "About Robert Peterson");
      appendStatus("skills", "Technical skills and platforms");
      appendStatus("projects", "Rock Solid Labs projects");
      appendStatus("status", "Live infrastructure health");
      appendStatus("uptime", "24-hour monitored uptime");
      appendStatus("whoami", "Current terminal identity");
      appendStatus("contact", "Contact information");
      appendStatus("orangebox", "OrangeBox overview");
      appendStatus("portarthur", "Port Arthur overview");
      appendStatus("clear", "Clear terminal output");

      appendLine("");
      appendLine(
        "Tip: ↑ and ↓ navigate command history.",
        "terminal-muted"
      );
      appendLine("");
    }

    function runAbout() {
      appendLine("");
      appendLine("ROBERT PETERSON", "terminal-orange");
      appendLine(
        "IT support and infrastructure professional focused on systems, networking, virtualization and reliable service operations."
      );
      appendLine(
        "Rock Solid Labs is the hands-on environment used to build, break, recover and improve those skills."
      );
      appendLine("");
    }

    function runSkills() {
      appendLine("");
      appendLine("TECHNICAL SKILLS", "terminal-orange");

      appendStatus(
        "Infrastructure",
        "Proxmox VE · Windows Server · Active Directory"
      );

      appendStatus(
        "Networking",
        "DNS · DHCP · VPN · SMB/CIFS · UniFi"
      );

      appendStatus(
        "Linux",
        "Ubuntu Server · Debian · LXC"
      );

      appendStatus(
        "Containers",
        "Docker · Docker Compose · Nginx"
      );

      appendStatus(
        "Cloud / SaaS",
        "Microsoft 365 · Entra ID · Cloudflare"
      );

      appendStatus(
        "Operations",
        "Backups · Monitoring · Troubleshooting · Recovery"
      );

      appendLine("");
    }

    function runProjects() {
      appendLine("");
      appendLine("ROCK SOLID LABS PROJECTS", "terminal-orange");

      appendStatus(
        "OrangeBox",
        "Primary virtualization and infrastructure platform"
      );

      appendStatus(
        "Project Orange",
        "Containerized application and monitoring platform"
      );

      appendStatus(
        "Port Arthur",
        "Dedicated application virtualization host"
      );

      appendStatus(
        "resume-web",
        "Self-hosted Astro + Nginx portfolio"
      );

      appendLine("");
      appendLine(
        "Open the Projects section for full build notes and case studies.",
        "terminal-muted"
      );
      appendLine("");
    }

    async function fetchMonitoring() {
      const [configResponse, heartbeatResponse] =
        await Promise.all([
          fetch(CONFIG_URL, { cache: "no-store" }),
          fetch(HEARTBEAT_URL, { cache: "no-store" })
        ]);

      if (!configResponse.ok || !heartbeatResponse.ok) {
        throw new Error("Monitoring endpoint unavailable");
      }

      return {
        config: await configResponse.json(),
        heartbeat: await heartbeatResponse.json()
      };
    }

    function latestHeartbeat(heartbeatData, id) {
      const beats =
        heartbeatData?.heartbeatList?.[String(id)] ||
        heartbeatData?.heartbeatList?.[id] ||
        [];

      if (!Array.isArray(beats) || beats.length === 0) {
        return null;
      }

      return beats[beats.length - 1];
    }

    async function runStatus() {
      appendLine("");
      appendLine(
        "ROCK SOLID LABS // LIVE STATUS",
        "terminal-orange"
      );

      appendLine("Querying monitoring service...", "terminal-muted");

      try {
        const { config, heartbeat } =
          await fetchMonitoring();

        const groups =
          config?.publicGroupList || [];

        let total = 0;
        let healthy = 0;

        groups.forEach((group) => {
          const monitors = group.monitorList || [];

          let groupHealthy = 0;

          monitors.forEach((monitor) => {
            const beat =
              latestHeartbeat(heartbeat, monitor.id);

            total += 1;

            if (beat && Number(beat.status) === 1) {
              healthy += 1;
              groupHealthy += 1;
            }
          });

          const state =
            groupHealthy === monitors.length &&
            monitors.length > 0
              ? "healthy"
              : groupHealthy > 0
                ? "warning"
                : "danger";

          appendStatus(
            group.name,
            `${groupHealthy}/${monitors.length} healthy`,
            state
          );
        });

        appendLine("");

        appendStatus(
          "Overall",
          `${healthy}/${total} monitored services healthy`,
          healthy === total ? "healthy" : "warning"
        );

        appendLine(
          "Source: Uptime Kuma via sanitized read-only status endpoints.",
          "terminal-muted"
        );
      } catch (error) {
        appendLine(
          "[STATUS] Monitoring data is temporarily unavailable.",
          "terminal-danger"
        );
      }

      appendLine("");
    }

    async function runUptime() {
      appendLine("");
      appendLine("24-HOUR UPTIME", "terminal-orange");

      try {
        const { config, heartbeat } =
          await fetchMonitoring();

        const groups =
          config?.publicGroupList || [];

        const monitors =
          groups.flatMap(
            (group) => group.monitorList || []
          );

        const values = [];

        monitors.forEach((monitor) => {
          const value =
            heartbeat?.uptimeList?.[`${monitor.id}_24`];

          if (typeof value === "number") {
            values.push(value * 100);
          }
        });

        if (!values.length) {
          appendLine(
            "No uptime data is currently available.",
            "terminal-muted"
          );
        } else {
          const average =
            values.reduce((a, b) => a + b, 0) /
            values.length;

          appendStatus(
            "Monitored Services",
            `${average.toFixed(2)}% average uptime`,
            average >= 99 ? "healthy" : "warning"
          );

          appendStatus(
            "Coverage",
            `${values.length} public monitors`
          );
        }
      } catch (error) {
        appendLine(
          "[STATUS] Unable to retrieve uptime data.",
          "terminal-danger"
        );
      }

      appendLine("");
    }

    function runWhoami() {
      appendLine("");
      appendLine("visitor", "terminal-orange");
      appendLine(
        "Role: Public portfolio guest"
      );
      appendLine(
        "Privileges: None whatsoever"
      );
      appendLine(
        "Shell access: Absolutely not"
      );
      appendLine("");
    }

    function runContact() {
      appendLine("");
      appendLine("CONTACT", "terminal-orange");
      appendLine(
        "Email: robertpeterson.kc@outlook.com"
      );
      appendLine(
        "LinkedIn: linkedin.com/in/robert-peterson-kc"
      );
      appendLine("");
    }

    function runOrangeBox() {
      appendLine("");
      appendLine("ORANGEBOX", "terminal-orange");
      appendLine(
        "Primary Rock Solid Labs virtualization host."
      );

      appendStatus("Hypervisor", "Proxmox VE");
      appendStatus("Storage", "TrueNAS SCALE");
      appendStatus(
        "Core Services",
        "DNS · VPN · Media · Automation"
      );
      appendStatus(
        "Application Platform",
        "Project Orange"
      );

      appendLine("");
    }

    function runPortArthur() {
      appendLine("");
      appendLine("PORT ARTHUR", "terminal-orange");
      appendLine(
        "Dedicated virtualization host for isolated application workloads."
      );

      appendStatus("Hypervisor", "Proxmox VE");
      appendStatus("Guests", "Ubuntu Server VMs");
      appendStatus(
        "Web Platform",
        "Astro · Nginx · Docker"
      );

      appendLine("");
    }

    function runClear() {
      output.replaceChildren();
    }

    function execute(rawCommand) {
      const command = rawCommand.trim();

      if (!command) return;

      appendCommand(command);

      history.push(command);
      historyIndex = history.length;

      const suspicious =
        suspiciousCommand(command);

      if (suspicious) {
        handleSuspicious(suspicious);
        return;
      }

      const normalized = normalize(command);

      const handler = commands[normalized];

      if (handler) {
        handler();
        return;
      }

      appendLine(
        `command not found: ${command}`,
        "terminal-danger"
      );

      appendLine(
        "Type 'help' for supported commands.",
        "terminal-muted"
      );

      appendLine("");
    }

    input.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        const value = input.value;

        input.value = "";

        execute(value);
      }

      if (event.key === "ArrowUp") {
        event.preventDefault();

        if (!history.length) return;

        historyIndex =
          Math.max(0, historyIndex - 1);

        input.value =
          history[historyIndex] || "";

        requestAnimationFrame(() => {
          input.setSelectionRange(
            input.value.length,
            input.value.length
          );
        });
      }

      if (event.key === "ArrowDown") {
        event.preventDefault();

        if (!history.length) return;

        historyIndex =
          Math.min(
            history.length,
            historyIndex + 1
          );

        input.value =
          historyIndex === history.length
            ? ""
            : history[historyIndex] || "";
      }
    });

    root
      .querySelectorAll("[data-terminal-command]")
      .forEach((button) => {
        button.addEventListener("click", () => {
          const command =
            button.getAttribute(
              "data-terminal-command"
            );

          input.value = command || "";
          input.focus();
        });
      });

    document
      .querySelector(".terminal-window")
      ?.addEventListener("click", () => {
        input.focus();
      });
  })();
</script>


