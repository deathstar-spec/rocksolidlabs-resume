---
import '../styles/global.css';
import LiveLabStatus from '../components/LiveLabStatus.astro';

const skills = [
  'Windows 10/11',
  'Windows Server',
  'Active Directory',
  'Microsoft 365',
  'Entra ID',
  'DNS / DHCP',
  'TCP/IP',
  'VPN / RDP',
  'SMB / CIFS',
  'UniFi',
  'PowerShell',
  'Proxmox VE',
  'TrueNAS SCALE',
  'Docker / Compose',
  'Linux / Ubuntu',
  'Backup & Recovery',
  'ConnectWise',
  'NinjaOne / RMM'
];

const certifications = [
  {
    name: 'CompTIA Security+ ce',
    issuer: 'CompTIA',
    date: 'Issued Oct 2025 · Expires Oct 2028'
  },
  {
    name: 'Microsoft 365 Certified: Fundamentals',
    issuer: 'Microsoft · MS-900',
    date: 'Issued Sep 2025'
  },
  {
    name: 'Barracuda Cloud-to-Cloud Backup - Foundation',
    issuer: 'Barracuda',
    date: 'Issued Nov 2025 · Expires Nov 2027'
  },
  {
    name: 'Cybersecurity Specialist - Network Support Badge',
    issuer: 'Centriq / Canvas Credentials',
    date: 'Issued Sep 2025'
  }
];

const orangeSteps = [
  'Deployed Proxmox VE as the virtualization foundation.',
  'Created Linux VMs and LXC containers for infrastructure and application services.',
  'Implemented TrueNAS SCALE for centralized storage and SMB/CIFS integration.',
  'Deployed DNS filtering, secure remote access, monitoring and home automation services.',
  'Built Project Orange as a Docker Compose application stack with VPN-routed services.',
  'Integrated persistent network storage with Linux and Docker workloads.',
  'Recovered from storage, mount and power-related failures and hardened service startup behavior.'
];

const portArthurSteps = [
  'Deployed a second Proxmox VE host to separate application workloads from OrangeBox.',
  'Designed separate VMs for workload isolation rather than installing applications on the hypervisor.',
  'Built Ubuntu Server guests with QEMU Guest Agent integration.',
  'Deployed Docker and Docker Compose inside dedicated application VMs.',
  'Created a dedicated resume-web VM for the Rock Solid Labs portfolio.',
  'Added Git version control before beginning the production site build.',
  'Built this portfolio using Astro, Docker and Nginx with Cloudflare publication planned through a secure tunnel.'
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Robert Peterson - IT Support, Infrastructure, Networking and Homelab Portfolio"
    />
    <title>Robert Peterson | Rock Solid Labs</title>
  </head>

  <body data-mode="recruiter">
    <header>
      <div class="container nav">
        <a class="brand" href="#">
          ROCK <span>SOLID</span> LABS
        </a>

        <nav>
          <a href="#about">About</a>
          <a href="#experience">Experience</a>
          <a href="#skills">Skills</a>
          <a href="#credentials">Credentials</a>
          <a href="#projects">Projects</a>
          <a href="#contact">Contact</a>

          <button
            class="mode-button"
            id="mode-toggle"
            type="button"
            aria-pressed="false"
          >
            Lab Mode
          </button>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container">
          <div class="eyebrow">
            IT Support · Infrastructure · Networking
          </div>

          <h1>Robert Peterson</h1>

          <p class="hero-copy">
            IT infrastructure professional with hands-on experience supporting
            Windows environments, servers, Microsoft 365, networking, backups,
            virtualization and business-critical systems — backed by more than
            a decade of technology leadership experience.
          </p>

          <div class="actions">
            <a class="button primary" href="#experience">
              View Experience
            </a>

            <a class="button secondary lab-only" href="#projects">
              Explore My Homelab
            </a>

            <a
              class="button secondary"
              href="https://www.linkedin.com/in/robert-peterson-kc"
              target="_blank"
              rel="noopener noreferrer"
            >
              LinkedIn
            </a>
          </div>

          <div class="status lab-only">
            <span class="status-dot"></span>
            This site is self-hosted on Port Arthur · Proxmox · Docker
          </div>
        </div>
      </section>

      <section id="about">
        <div class="container">
          <div class="eyebrow">About</div>

          <h2 class="section-title">
            Infrastructure-minded support with a builder's mindset.
          </h2>

          <div class="about-grid">
            <div>
              <p class="section-intro">
                My professional work centers on keeping users and business
                systems operational while continuing to move deeper into
                infrastructure and networking.
              </p>

              <p class="body-copy">
                I support multi-site environments across Windows endpoints,
                Windows Server, Active Directory, Microsoft 365, networking,
                storage, backup and recovery, and specialized line-of-business
                applications.
              </p>

              <p class="body-copy">
                Outside of work, I design and operate a production-style
                homelab where I build, break, recover and improve virtualized
                infrastructure, Linux systems, storage, networking and
                containerized services.
              </p>
            </div>

            <div class="quick-facts">
              <div>
                <strong>Current Focus</strong>
                <span>Infrastructure & Networking</span>
              </div>

              <div>
                <strong>Professional IT</strong>
                <span>Healthcare IT + MSP</span>
              </div>

              <div>
                <strong>Leadership</strong>
                <span>10+ years</span>
              </div>

              <div>
                <strong>Location</strong>
                <span>Kansas City Area</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="experience">
        <div class="container">
          <div class="eyebrow">Experience</div>

          <h2 class="section-title">
            From technology leadership to hands-on infrastructure.
          </h2>

          <p class="section-intro">
            My background combines customer-facing technology leadership with
            increasingly infrastructure-focused IT support.
          </p>

          <div class="timeline">

            <article class="role">
              <div class="role-date">
                Feb 2026 — Present
              </div>

              <div>
                <h3>Help Desk Agent · Goetze Dental</h3>

                <p>
                  Tier 1 / Tier 2 remote and on-site support for dental
                  practices where technology availability directly affects
                  clinical operations.
                </p>

                <ul class="detail-list">
                  <li>
                    Support Windows workstations and servers, Active Directory,
                    DNS, DHCP, SMB, permissions, RDP and domain connectivity.
                  </li>
                  <li>
                    Plan and support server replacements, storage upgrades,
                    backup readiness and migration sequencing.
                  </li>
                  <li>
                    Support Microsoft 365, endpoint deployments, printers,
                    peripherals and business-critical clinical applications.
                  </li>
                  <li>
                    Assist with backup, recovery and data migration workflows
                    in security-sensitive healthcare environments.
                  </li>
                  <li>
                    Build PowerShell automation for deployment, updates,
                    validation, logging and recovery workflows.
                  </li>
                </ul>
              </div>
            </article>

            <article class="role">
              <div class="role-date">
                Nov 2025 — Feb 2026
              </div>

              <div>
                <h3>
                  Service Desk Technician · Complete Technology Services
                </h3>

                <p>
                  Tier 1–2 support across approximately 50 SMB environments in
                  a Managed Service Provider setting.
                </p>

                <ul class="detail-list">
                  <li>
                    Supported Windows, Microsoft 365, Active Directory,
                    Outlook/Exchange, Teams, MFA and Entra ID joins.
                  </li>
                  <li>
                    Diagnosed LAN, Wi-Fi, DNS, DHCP and VPN connectivity issues.
                  </li>
                  <li>
                    Performed workstation deployments, onboarding, peripheral
                    installation and office technology upgrades.
                  </li>
                  <li>
                    Used ConnectWise and RMM tooling to document incidents,
                    escalation and remediation.
                  </li>
                </ul>
              </div>
            </article>

            <article class="role">
              <div class="role-date">
                2012 — 2025
              </div>

              <div>
                <h3>Technology Leadership · Best Buy</h3>

                <p>
                  Progressed through technology sales and leadership roles,
                  including Sales Team Lead, Back Office Lead, Specialty Sales
                  Manager, Consult & Design Supervisor and Experience
                  Supervisor.
                </p>

                <ul class="detail-list">
                  <li>
                    Led customer-facing technology teams and owned escalated
                    technical and service issues.
                  </li>
                  <li>
                    Coached and developed employees while coordinating daily
                    operational priorities.
                  </li>
                  <li>
                    Designed technology solutions involving computing,
                    networking, smart-home and connected systems.
                  </li>
                  <li>
                    Built a strong foundation in communication, troubleshooting,
                    escalation ownership and team leadership.
                  </li>
                </ul>
              </div>
            </article>

          </div>
        </div>
      </section>

      <section id="skills">
        <div class="container">
          <div class="eyebrow">Technical Stack</div>

          <h2 class="section-title">
            Tools and technologies I actually use.
          </h2>

          <div class="tag-list">
            {skills.map((skill) => (
              <span class="tag">{skill}</span>
            ))}
          </div>
        </div>
      </section>

      <section id="credentials">
        <div class="container">
          <div class="eyebrow">Credentials</div>

          <h2 class="section-title">
            Certifications & education.
          </h2>

          <div class="credential-grid">
            {certifications.map((cert) => (
              <article class="card">
                <div class="credential-type">
                  CERTIFICATION
                </div>

                <h3>{cert.name}</h3>
                <p>{cert.issuer}</p>
                <div class="credential-date">{cert.date}</div>
              </article>
            ))}
          </div>

          <div class="education-list">

            <article class="education-item">
              <div>
                <strong>Centriq's IT Career Program</strong>
                <span>Cyber Security</span>
              </div>

              <div>
                Jul 2025 — Nov 2025
              </div>
            </article>

            <article class="education-item">
              <div>
                <strong>Missouri Western State University</strong>
                <span>Associate of Arts · Education</span>
              </div>

              <div>
                2008 — 2010
              </div>
            </article>

          </div>
        </div>
      </section>

      <section id="projects" class="lab-only">
        <div class="container">
          <LiveLabStatus />
          <div class="eyebrow">Rock Solid Labs</div>

          <h2 class="section-title">
            Built, broken, recovered and improved.
          </h2>

          <p class="section-intro">
            These projects are intentionally documented without private
            addressing, credentials or sensitive internal configuration.
          </p>

          <div class="project-case">

            <div class="project-heading">
              <div>
                <span class="project-number">01</span>
                <h3>OrangeBox Infrastructure Lab</h3>
              </div>

              <span class="project-status">
                ACTIVE
              </span>
            </div>

            <p class="project-summary">
              A Proxmox-based infrastructure environment used to run
              virtualization, centralized storage, networking, media,
              monitoring, automation and remote-access services.
            </p>

            <div class="project-meta">
              <span>Proxmox VE</span>
              <span>TrueNAS SCALE</span>
              <span>Linux</span>
              <span>Docker</span>
              <span>WireGuard</span>
              <span>Pi-hole</span>
              <span>SMB/CIFS</span>
            </div>

            <h4>How it was built</h4>

            <ol class="build-steps">
              {orangeSteps.map((step, index) => (
                <li>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <p>{step}</p>
                </li>
              ))}
            </ol>

            <div class="lesson-box">
              <strong>What this project taught me</strong>

              <p>
                Service dependencies matter. Storage, networking, permissions,
                mounts and container configuration can all appear as an
                application failure. Troubleshooting the environment as a
                complete system has been more valuable than simply deploying
                individual services.
              </p>
            </div>

          </div>

          <div class="project-case">

            <div class="project-heading">
              <div>
                <span class="project-number">02</span>
                <h3>Port Arthur Application Platform</h3>
              </div>

              <span class="project-status">
                ACTIVE
              </span>
            </div>

            <p class="project-summary">
              A second Proxmox environment created to isolate public-facing
              application workloads from the primary homelab infrastructure.
            </p>

            <div class="project-meta">
              <span>Proxmox VE</span>
              <span>Ubuntu Server</span>
              <span>Docker</span>
              <span>Astro</span>
              <span>Nginx</span>
              <span>Git</span>
              <span>Cloudflare</span>
            </div>

            <h4>How this site was built</h4>

            <ol class="build-steps">
              {portArthurSteps.map((step, index) => (
                <li>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <p>{step}</p>
                </li>
              ))}
            </ol>

            <div class="lesson-box">
              <strong>Design decision</strong>

              <p>
                Public and private workloads are separated into dedicated
                virtual machines instead of installing Docker directly on the
                Proxmox hypervisor. That provides cleaner isolation, simpler
                recovery and safer experimentation.
              </p>
            </div>

          </div>

          <div class="site-built-here">
            <span class="status-dot"></span>

            <div>
              <strong>You are viewing one of the projects.</strong>

              <p>
                This portfolio is built with Astro, compiled in Docker, served
                by Nginx and hosted from my own virtualized infrastructure.
              </p>
            </div>
          </div>

        </div>
      </section>

      <section id="contact">
        <div class="container">
          <div class="eyebrow">Contact</div>

          <h2 class="section-title">
            Let's connect.
          </h2>

          <p class="section-intro">
            I'm interested in infrastructure, networking, systems
            administration and opportunities where I can continue building
            deeper hands-on experience.
          </p>

          <div class="actions">
            <a
              class="button primary"
              href="mailto:robertpeterson.kc@outlook.com"
            >
              Email Robert
            </a>

            <a
              class="button secondary"
              href="https://www.linkedin.com/in/robert-peterson-kc"
              target="_blank"
              rel="noopener noreferrer"
            >
              LinkedIn
            </a>
          </div>
        </div>
      </section>

    </main>

    <footer>
      <div class="container">
        Rock Solid Labs · Designed, built and self-hosted by Robert Peterson.
      </div>
    </footer>

    <script>
      const button = document.querySelector('#mode-toggle');

      button?.addEventListener('click', () => {
        const current = document.body.dataset.mode;
        const labMode = current !== 'lab';

        document.body.dataset.mode =
          labMode ? 'lab' : 'recruiter';

        button.textContent =
          labMode ? 'Recruiter Mode' : 'Lab Mode';

        button.setAttribute(
          'aria-pressed',
          String(labMode)
        );
      });
    </script>
  </body>
</html>
