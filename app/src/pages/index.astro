---
import '../styles/global.css';

const skills = [
  'Windows Server',
  'Active Directory',
  'Microsoft 365',
  'Networking',
  'UniFi',
  'Proxmox',
  'Docker',
  'Linux',
  'PowerShell',
  'DNS / DHCP',
  'Backup & DR',
  'Cloudflare'
];

const projects = [
  {
    number: '01',
    name: 'OrangeBox',
    description: 'Proxmox-based homelab platform supporting storage, media, automation, networking and infrastructure services.'
  },
  {
    number: '02',
    name: 'Project Orange',
    description: 'Containerized application environment combining Docker networking, VPN routing, automation and supporting services.'
  },
  {
    number: '03',
    name: 'Port Arthur',
    description: 'Dedicated Proxmox application host for public-facing projects, isolated workloads and Rock Solid Labs services.'
  }
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Robert Peterson - IT Support, Infrastructure, Networking and Homelab Portfolio"
    />
    <title>Robert Peterson | Rock Solid Labs</title>
  </head>

  <body data-mode="recruiter">
    <header>
      <div class="container nav">
        <a class="brand" href="#">
          ROCK <span>SOLID</span> LABS
        </a>

        <nav>
          <a href="#experience">Experience</a>
          <a href="#skills">Skills</a>
          <a href="#projects">Projects</a>
          <a href="#contact">Contact</a>

          <button
            class="mode-button"
            id="mode-toggle"
            type="button"
            aria-pressed="false"
          >
            Lab Mode
          </button>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container">
          <div class="eyebrow">IT Support · Infrastructure · Networking</div>

          <h1>Robert Peterson</h1>

          <p class="hero-copy">
            I support, troubleshoot and build the systems behind modern IT
            environments — from Windows infrastructure and Microsoft 365 to
            networking, virtualization and self-hosted services.
          </p>

          <div class="actions">
            <a class="button primary" href="#experience">View Experience</a>
            <a class="button secondary lab-only" href="#projects">
              Explore My Lab
            </a>
          </div>

          <div class="status lab-only">
            <span class="status-dot"></span>
            Self-hosted on Port Arthur · Proxmox · Docker
          </div>
        </div>
      </section>

      <section id="experience">
        <div class="container">
          <div class="eyebrow">Experience</div>
          <h2 class="section-title">Hands-on IT experience.</h2>

          <p class="section-intro">
            Supporting real users, real networks and production systems while
            continuing to build deeper infrastructure and networking skills.
          </p>

          <div class="timeline">
            <article class="role">
              <div class="role-date">Current</div>
              <div>
                <h3>IT Services · Goetze Dental</h3>
                <p>
                  Windows environments, server infrastructure, Microsoft 365,
                  networking, backup systems, hardware deployments and
                  specialized dental technology.
                </p>
              </div>
            </article>

            <article class="role">
              <div class="role-date">Previous</div>
              <div>
                <h3>Help Desk Technician · MSP Environment</h3>
                <p>
                  Supported multiple business environments across Microsoft 365,
                  Windows, printers, identity, VPN, remote support and end-user
                  troubleshooting.
                </p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section id="skills">
        <div class="container">
          <div class="eyebrow">Technical Stack</div>
          <h2 class="section-title">Tools I actually work with.</h2>

          <div class="tag-list">
            {skills.map((skill) => <span class="tag">{skill}</span>)}
          </div>
        </div>
      </section>

      <section>
        <div class="container">
          <div class="eyebrow">Certifications</div>
          <h2 class="section-title">Continued learning.</h2>

          <div class="grid">
            <article class="card">
              <h3>CompTIA Security+</h3>
              <p>Security fundamentals, risk, identity and infrastructure.</p>
            </article>

            <article class="card">
              <h3>Microsoft 365 Fundamentals</h3>
              <p>Microsoft cloud services, administration and productivity.</p>
            </article>

            <article class="card">
              <h3>CCNA</h3>
              <p>Currently progressing toward Cisco networking certification.</p>
            </article>
          </div>
        </div>
      </section>

      <section id="projects" class="lab-only">
        <div class="container">
          <div class="eyebrow">Homelab</div>
          <h2 class="section-title">Built, broken, rebuilt.</h2>

          <p class="section-intro">
            My homelab is where I experiment with infrastructure, networking,
            containers and services outside production environments.
          </p>

          <div class="grid">
            {projects.map((project) => (
              <article class="card">
                <div class="project-number">{project.number}</div>
                <h3>{project.name}</h3>
                <p>{project.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="contact">
        <div class="container">
          <div class="eyebrow">Contact</div>
          <h2 class="section-title">Let’s connect.</h2>

          <p class="section-intro">
            Interested in infrastructure, networking, systems administration
            and opportunities to keep building.
          </p>

          <div class="actions">
            <a
              class="button primary"
              href="mailto:robertpeterson.kc@outlook.com"
            >
              Email Robert
            </a>

            <a
              class="button secondary"
              href="https://www.linkedin.com/in/robert-peterson-kc"
              target="_blank"
              rel="noopener noreferrer"
            >
              LinkedIn
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container">
        Rock Solid Labs · Designed, built and self-hosted by Robert Peterson.
      </div>
    </footer>

    <script>
      const button = document.querySelector('#mode-toggle');

      button?.addEventListener('click', () => {
        const current = document.body.dataset.mode;
        const labMode = current !== 'lab';

        document.body.dataset.mode = labMode ? 'lab' : 'recruiter';
        button.textContent = labMode ? 'Recruiter Mode' : 'Lab Mode';
        button.setAttribute('aria-pressed', String(labMode));
      });
    </script>
  </body>
</html>
