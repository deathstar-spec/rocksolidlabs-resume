server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /api/lab-status/config {
        proxy_pass http://kuma.orange.lab/api/status-page/rock-solid-labs;
        proxy_set_header Host kuma.orange.lab;
        proxy_http_version 1.1;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }

    location = /api/lab-status/heartbeat {
        proxy_pass http://kuma.orange.lab/api/status-page/heartbeat/rock-solid-labs;
        proxy_set_header Host kuma.orange.lab;
        proxy_http_version 1.1;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }
}
